# Backend Environment Variables
PROJECT_NAME="OCR Scan-to-PDF Engine"
API_V1_STR="/api/v1"

# Comma-separated list of origins for CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost"]

# Default OCR languages
OCR_LANGUAGES=["en"]

# Local storage directories
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"
